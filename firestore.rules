rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Pillar 1: Master Gate (Relational Sync with Parent UserWorkspace)
    function isWorkspaceOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // Pillar 2: Validation Blueprint for UserWorkspace
    function isValidUserWorkspace(data) {
      return data.keys().hasAll([
          'ownerId',
          'contentHash',
          'schemaVersion',
          'sectionCount',
          'timerState',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'contentHash',
          'schemaVersion',
          'sectionCount',
          'timerState',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.contentHash is string &&
        data.contentHash.size() >= 1 &&
        data.contentHash.size() <= 128 &&
        data.schemaVersion is number &&
        data.schemaVersion >= 1 &&
        data.schemaVersion <= 100 &&
        data.sectionCount is number &&
        data.sectionCount >= 0 &&
        data.sectionCount <= 500 &&
        data.timerState is map &&
        data.timerState.size() >= 1 &&
        data.timerState.size() <= 10 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Pillar 2: Validation Blueprint for StudyDbRecord
    function isValidStudyDbRecord(data) {
      return data.keys().hasAll([
          'ownerId',
          'section',
          'chunkIndex',
          'chunkTotal',
          'contentHash',
          'payload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'section',
          'chunkIndex',
          'chunkTotal',
          'contentHash',
          'payload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.section is string &&
        data.section.size() >= 1 &&
        data.section.size() <= 64 &&
        data.section.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chunkIndex is number &&
        data.chunkIndex >= 0 &&
        data.chunkIndex <= 500 &&
        data.chunkTotal is number &&
        data.chunkTotal >= 1 &&
        data.chunkTotal <= 500 &&
        data.contentHash is string &&
        data.contentHash.size() >= 1 &&
        data.contentHash.size() <= 128 &&
        data.payload is map &&
        data.payload.size() >= 1 &&
        data.payload.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        existing().ownerId == request.auth.uid;

      allow list: if isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserWorkspace(incoming()) &&
        incoming().ownerId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserWorkspace(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: SyncWorkspaceMeta
          incoming().diff(existing()).affectedKeys().hasOnly([
            'contentHash',
            'schemaVersion',
            'sectionCount',
            'timerState',
            'updatedAt'
          ]) ||
          // Action: SyncTimerOnly
          incoming().diff(existing()).affectedKeys().hasOnly([
            'timerState',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        existing().ownerId == request.auth.uid;

      // Collection 2: /users/{userId}/dbRecords/{recordId}
      match /dbRecords/{recordId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(recordId) &&
          request.auth.uid == userId &&
          existing().ownerId == request.auth.uid &&
          isWorkspaceOwner(userId);

        allow list: if isSignedIn() &&
          request.auth.uid == userId &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(recordId) &&
          request.auth.uid == userId &&
          isValidStudyDbRecord(incoming()) &&
          incoming().ownerId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(userId);

        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(recordId) &&
          request.auth.uid == userId &&
          isValidStudyDbRecord(incoming()) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().section == existing().section &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action: UpdateRecordChunk
            incoming().diff(existing()).affectedKeys().hasOnly([
              'chunkIndex',
              'chunkTotal',
              'contentHash',
              'payload',
              'updatedAt'
            ]) ||
            // Action: UpdateRecordPayloadOnly
            incoming().diff(existing()).affectedKeys().hasOnly([
              'contentHash',
              'payload',
              'updatedAt'
            ])
          ) &&
          isWorkspaceOwner(userId);

        allow delete: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(recordId) &&
          request.auth.uid == userId &&
          existing().ownerId == request.auth.uid &&
          isWorkspaceOwner(userId);
      }
    }
  }
}
